#!/usr/bin/env bash

PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi}"

bwrap \
  --unshare-all \
  --share-net \
  --die-with-parent \
  --ro-bind / / \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --bind "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_DIR" \
  --bind "$PWD" "$PWD" \
  --chdir "$PWD" \
  -- pi "$@"
